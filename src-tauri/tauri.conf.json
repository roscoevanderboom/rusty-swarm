{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rusty-hermes",
  "version": "0.1.0",
  "identifier": "rusty-hermes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
      "windows": [
        {
          "title": "rusty-hermes",
          "width": 1440,
          "height": 900,
          "center": true,
          "visible": false,
          "minWidth": 900,
          "minHeight": 700
        }
      ],
      "security": {
        "csp": null
      }
    },
    "plugins": {
      "cli": {}
    },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
